# ==============================================================================
# Gabster AI - Production Configuration Environment Template
# ==============================================================================

# Application Environment
ENVIRONMENT=development
APP_NAME=gabster-ai
DEBUG=false
SECRET_KEY=change-this-in-production-to-at-least-64-character-cryptographically-secure-key
API_V1_STR=/api/v1
SERVER_HOST=0.0.0.0
SERVER_PORT=8000
ALLOWED_HOSTS=["localhost", "127.0.0.1", "app.gabster.local"]
CORS_ORIGINS=["http://localhost:3000", "http://localhost:8000", "https://app.gabster.ai"]

# Database Configuration (PostgreSQL 16 with pgvector & RLS)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gabster_ai
POSTGRES_USER=gabster_app
POSTGRES_PASSWORD=secure_app_password
POSTGRES_ADMIN_USER=postgres
POSTGRES_ADMIN_PASSWORD=secure_postgres_password
DATABASE_URL=postgresql+asyncpg://gabster_app:secure_app_password@localhost:5432/gabster_ai
DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:secure_postgres_password@localhost:5432/gabster_ai
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# Redis Configuration (Cache, Sessions, Celery Broker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0
REDIS_CACHE_TTL_SECONDS=3600

# Celery Background Task Processing
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_ALWAYS_EAGER=false

# Security & Authentication
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=30
INVITATION_EXPIRE_HOURS=72
SESSION_IDLE_TIMEOUT_MINUTES=120
ENCRYPTION_KEY=gAAAAABl-secure-32-byte-base64-fernet-key-for-secrets-at-rest=
BCRYPT_ROUNDS=12

# Storage / S3 Configuration
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=./storage_uploads
S3_BUCKET_NAME=gabster-media-uploads
S3_REGION=us-east-1
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_ENDPOINT_URL=

# AI Model Provider Credentials
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=
VOICE_API_KEY=

# Messaging Channel Integrations
META_WHATSAPP_API_TOKEN=
META_WHATSAPP_PHONE_NUMBER_ID=
META_WHATSAPP_WABA_ID=
META_WEBHOOK_VERIFY_TOKEN=gabster_meta_verify_token_secure_string

TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Payment & Billing (Stripe)
STRIPE_API_KEY=sk_test_51...
STRIPE_WEBHOOK_SECRET=whsec_...

# Observability & Monitoring
LOG_LEVEL=INFO
ENABLE_METRICS=true
METRICS_PORT=9090
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4317
OTEL_SERVICE_NAME=gabster-ai-backend
