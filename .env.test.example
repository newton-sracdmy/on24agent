# ==============================================================================
# Gabster AI - Test Environment Configuration
# ==============================================================================

ENVIRONMENT=test
APP_NAME=gabster-ai-test
DEBUG=true
SECRET_KEY=test-secret-key-at-least-64-characters-long-for-testing-purposes-only-1234567890
API_V1_STR=/api/v1
SERVER_HOST=127.0.0.1
SERVER_PORT=8001
ALLOWED_HOSTS=["*"]
CORS_ORIGINS=["*"]

# Test Database (separate DB for isolation)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_DB=gabster_ai_test
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gabster_ai_test
DATABASE_ADMIN_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gabster_ai_test
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT=10
DB_ECHO=false

# Test Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=15
REDIS_URL=redis://localhost:6379/15
REDIS_CACHE_TTL_SECONDS=60

# Celery Task Processing for Testing (eager execution)
CELERY_BROKER_URL=memory://
CELERY_RESULT_BACKEND=cache+memory://
CELERY_TASK_ALWAYS_EAGER=true

# Security & Authentication for Testing
ACCESS_TOKEN_EXPIRE_MINUTES=5
REFRESH_TOKEN_EXPIRE_DAYS=1
INVITATION_EXPIRE_HOURS=1
SESSION_IDLE_TIMEOUT_MINUTES=30
ENCRYPTION_KEY=dGhpcy1pcy1hLXRlc3QtMzItYnl0ZS1rZXktZm9yLWZlcm5ldC0=
BCRYPT_ROUNDS=4

# Storage
STORAGE_BACKEND=local
STORAGE_LOCAL_ROOT=/tmp/gabster_test_uploads

LOG_LEVEL=DEBUG
ENABLE_METRICS=false
